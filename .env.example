# FlowForge — Stage 1 Environment Variables
# Copy this file to .env and fill in values.
# Do NOT commit .env to source control.

# PostgreSQL (Port 5433 when connecting from host to Docker Compose container; Port 5432 for native local Postgres)
DATABASE_URL=postgres://flowforge:flowforge_password@localhost:5433/flowforge?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379
REDIS_STREAM=flowforge:jobs
REDIS_CONSUMER_GROUP=flowforge-workers

# API Server
SERVER_PORT=8080
