# FlowForge — Stage 1 Environment Variables
# Copy this file to .env and fill in values.
# Do NOT commit .env to source control.

# PostgreSQL
DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=flowforge:jobs
REDIS_CONSUMER_GROUP=flowforge-workers

# API Server
SERVER_PORT=8080
